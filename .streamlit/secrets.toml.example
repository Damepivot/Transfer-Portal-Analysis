# Copy this to .streamlit/secrets.toml for local testing of the password gate.
# On Streamlit Cloud, paste these values into the Secrets field in the dashboard.
# Never commit secrets.toml to GitHub — it is in .gitignore.

APP_PASSWORD = "your_password_here"

DB_NAME     = "postgres"
DB_USER     = "postgres.your-project-ref"
DB_HOST     = "aws-0-us-east-1.pooler.supabase.com"
DB_PORT     = "6543"
DB_PASSWORD = "your-supabase-db-password"
